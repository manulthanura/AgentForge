# App
APP_ENV=development
LOG_LEVEL=info
SECRET_KEY=

# LLM provider selection: anthropic | openai | ollama | openrouter.
# Switching providers is env-only — no code changes required.
LLM_PROVIDER=anthropic
MAX_AGENT_STEPS=8

# Postgres (state persistence)
DATABASE_URL=postgresql://user:pass@localhost:5432/agentforge

# Redis / Celery (task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# GitHub integration
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Code searcher adapter: tree_sitter (AST-aware, ranked) | filesystem (fallback)
CODE_SEARCHER=tree_sitter

# Slack (approval gateway)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=

# LLM provider CREDENTIALS ONLY — no model names here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers OpenRouter shows on its public rankings
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Observability (tracing stays off unless LANGCHAIN_API_KEY is set)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentforge

# Resilience: retry/backoff (2s, 4s, 8s) and compound-failure cap
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
MAX_CONSECUTIVE_FAILURES=3

# Sandbox
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=120

# Approval timeout (from your ADRs)
APPROVAL_TIMEOUT_HOURS=72