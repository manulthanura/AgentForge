# App
# NOTE: APP_ENV is not yet read by any code (reserved for future use).
APP_ENV=development
# Console log level (DEBUG|INFO|WARNING|ERROR) — also controls whether the
# per-decision reasoning log lines and comment-hook confirmations show up.
LOG_LEVEL=info
# Shared secret for the admin API (model-config PATCH). Leave blank to disable
# that endpoint entirely (it responds 503 rather than running unauthenticated).
SECRET_KEY=

# LLM provider selection: anthropic | openai | ollama | openrouter | azure | gemini | huggingface.
# Switching providers is env-only — no code changes required.
LLM_PROVIDER=anthropic
# Optional model override; defaults come from src/shared_kernel/config/model_config.json.
LLM_MODEL=
MAX_AGENT_STEPS=8

# Postgres (state persistence)
DATABASE_URL=postgresql://user:pass@localhost:5432/agentforge

# Redis / Celery (task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# GitHub integration
# GITHUB_TOKEN + GITHUB_REPO enable issue reading and PR creation; leave both
# blank to run with that integration disabled.
GITHUB_TOKEN=
GITHUB_REPO=
# NOTE: GITHUB_APP_ID / GITHUB_PRIVATE_KEY are not yet read by any code
# (reserved for a future GitHub App auth mode; PAT auth via GITHUB_TOKEN is
# what's implemented today).
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
# Required for the /webhooks/github endpoint — requests fail signature
# verification (401) when this is blank.
GITHUB_WEBHOOK_SECRET=

# Code searcher adapter: tree_sitter (AST-aware, ranked) | filesystem (fallback)
CODE_SEARCHER=tree_sitter

# Local checkout the code searcher scans when a workflow runs (this process
# does not clone GITHUB_REPO itself). Defaults to "." (the server's own
# directory) — point this at a real repo's clone to test against real code.
WORKSPACE_PATH=.

# Slack (approval gateway)
# NOTE: SLACK_BOT_TOKEN is not yet read by any code — outbound notifications
# use an incoming webhook (SLACK_WEBHOOK_URL below), not the Bot API.
SLACK_BOT_TOKEN=
# Incoming webhook URL used to post approval requests to Slack. Leave blank
# to disable the Slack notification channel (SMTP can be used instead/also).
SLACK_WEBHOOK_URL=
# Required to verify inbound Slack interaction payloads (Approve/Reject
# button clicks) — those requests are rejected (401) when this is blank.
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=#agent-approvals

# LLM provider CREDENTIALS ONLY (set only the provider you are using; leave others blank)
ANTHROPIC_API_KEY=

OPENAI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers OpenRouter shows on its public rankings
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT= # Deployment name in your Azure resource; falls back to the model name

GOOGLE_API_KEY=

HUGGINGFACEHUB_API_TOKEN=
# Optional: point at a dedicated Inference Endpoint instead of the serverless API.
HUGGINGFACE_ENDPOINT_URL=
HUGGINGFACE_TASK=text-generation

# Email (approval gateway) — alternative/additional notification channel.
# Enabled when both SMTP_HOST and SMTP_TO are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=agentforge@localhost
SMTP_TO=

# Observability (tracing stays off unless LANGCHAIN_API_KEY is set)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentforge

# Resilience: retry/backoff (2s, 4s, 8s) and compound-failure cap
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
MAX_CONSECUTIVE_FAILURES=3

# Sandbox
# NOTE: SANDBOX_MEMORY_LIMIT / SANDBOX_TIMEOUT_SECONDS are not yet read by any
# code (reserved for the Docker test-execution sandbox described in the ADRs;
# not implemented yet).
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=120

# Human-in-the-loop approval gate
REQUIRE_APPROVAL=true
MAX_APPROVAL_RETRIES=3
# Approval timeouts (from your ADRs): reminder at 48h, hard timeout at 72h.
APPROVAL_REMINDER_HOURS=48
APPROVAL_TIMEOUT_HOURS=72